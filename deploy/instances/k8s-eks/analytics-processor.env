# spiffe://<trust-domain>/svc/analytics/processor — the identical manifest in a
# different project. It gets a different identity from the same resource, the
# payments peers refuse it, and it points at the payments AWS role on purpose so
# the page shows AWS refusing it too.
NAMESPACE=analytics
NAME=processor
PEERS=processor.payments:8443,ledger.payments:8443
AWS_ROLE_ARN=arn:aws:iam::165258854585:role/spiffe-payments-processor
AWS_SECRET_ID=demo/payments/processor
AWS_REGION=us-east-2
