# spiffe://<your-teleport-cluster>/svc/analytics/processor — the identical manifest in
# a different project. It gets a different identity from the same resource, the
# payments peers refuse it, and if you point it at the payments AWS role on purpose the
# page shows AWS refusing it too (403).
NAMESPACE=analytics
NAME=processor
PEERS=processor.payments:8443,ledger.payments:8443
#AWS_ROLE_ARN=arn:aws:iam::123456789012:role/spiffe-payments-processor
#AWS_SECRET_ID=demo/payments/processor
#AWS_REGION=us-east-2
