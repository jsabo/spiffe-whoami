# spiffe://<your-teleport-cluster>/svc/payments/processor
# NAMESPACE and NAME are the whole identity: the ServiceAccount NAME in NAMESPACE.
NAMESPACE=payments
NAME=processor
# Peers to call over mTLS (Service DNS, port 8443). ledger is in the same project
# and will accept; analytics/processor is another project and will refuse.
PEERS=ledger.payments:8443,processor.analytics:8443
# Optional. Leave unset until aws/main.tf has been applied; the page then shows
# "not configured" instead of an error.
#AWS_ROLE_ARN=arn:aws:iam::123456789012:role/spiffe-payments-processor
#AWS_SECRET_ID=demo/payments/processor
#AWS_REGION=us-east-2
